@page
@model Grad_Project.Pages.JobTitlePages.DeleteModel

@{
    ViewData["Title"] = "Delete Job Title";
}

<h1 class="h3">Delete Job Title</h1>
<h5 class="text-danger">Are you sure you want to delete this?</h5>
<hr />

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.JobTitle.Title)</dt>
    <dd class="col-sm-10">@Model.JobTitle.Title</dd>
</dl>

<form method="post" asp-page="./Delete" asp-route-id="@Model.JobTitle.Id">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</form>