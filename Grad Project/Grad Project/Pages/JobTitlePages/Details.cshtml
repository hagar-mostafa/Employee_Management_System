@page
@model Grad_Project.Pages.JobTitlePages.DetailsModel

@{
    ViewData["Title"] = "Job Title Details";
}

<h1 class="h3">Job Title Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.JobTitle.Title)</dt>
    <dd class="col-sm-10">@Model.JobTitle.Title</dd>
</dl>

<a asp-page="./Edit" asp-route-id="@Model.JobTitle.Id" class="btn btn-warning">Edit</a>
<a asp-page="./Index" class="btn btn-secondary">Back to List</a>