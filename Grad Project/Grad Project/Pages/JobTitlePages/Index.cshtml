@page
@model Grad_Project.Pages.JobTitlePages.IndexModel

@{
    ViewData["Title"] = "Job Titles";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Job Titles</h1>
    <a asp-page="./Create" class="btn btn-primary">+ Create New</a>
</div>

@if (Model.JobTitles.Count == 0)
{
    <div class="alert alert-info">No job titles found.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.JobTitles[0].Title)</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.JobTitles)
            {
                <tr>
                    <td>@item.Title</td>
                    <td class="text-end">
                        <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}