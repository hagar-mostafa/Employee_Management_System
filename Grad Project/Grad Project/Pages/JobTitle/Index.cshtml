@page
@model Grad_Project.Pages.JobTitlePages.IndexModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Job Titles";
}

<div class="section-header">
    <div>
        <h2>Job Titles</h2>
        <p>Manage all job titles in the organization</p>
    </div>
    <a asp-page="./Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Job Title
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert success">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert error">
        <i class="fas fa-exclamation-circle"></i>
        @TempData["Error"]
    </div>
}

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Job Title</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.JobTitles.Count == 0)
            {
                <tr>
                    <td colspan="3">
                        <div class="empty-state">
                            <i class="fas fa-briefcase"></i>
                            <h3>No Job Titles Found</h3>
                            <p>Start by adding a new job title</p>
                            <a asp-page="./Create" class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Add Job Title
                            </a>
                        </div>
                    </td>
                </tr>
            }
            else
            {
                int i = 1;
                foreach (var item in Model.JobTitles)
                {
                    <tr>
                        <td style="color:var(--text-muted);font-size:12px">@i.ToString("D2")</td>
                        <td style="font-weight:500">@item.Title</td>
                        <td>
                            <div class="action-btns">
                                <a asp-page="./Details" asp-route-id="@item.Id"
                                   class="act-btn view" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.Id"
                                   class="act-btn edit" title="Edit">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.Id"
                                   class="act-btn delete" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>
