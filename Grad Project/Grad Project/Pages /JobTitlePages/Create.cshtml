@page
@model Grad_Project.Pages.JobTitlePages.CreateModel

@{
    ViewData["Title"] = "Create Job Title";
}

<h1 class="h3">Create Job Title</h1>
<hr />

<div class="row">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="JobTitle.Title" class="form-label"></label>
                <input asp-for="JobTitle.Title" class="form-control" />
                <span asp-validation-for="JobTitle.Title" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
