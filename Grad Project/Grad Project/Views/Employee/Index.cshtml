@model IEnumerable<Employee>

@{
    ViewData["Title"] = "Employees";
}

<style>
    body {
        margin: 0;
        background-color: #f4f6f9;
        font-family: Arial, sans-serif;
        color: #1f2937;
    }

    .staffhub-wrapper {
        display: flex;
        min-height: calc(100vh - 0px);
    }

    /* Sidebar */
    .staffhub-sidebar {
        width: 190px;
        min-height: 100vh;
        background-color: #182235;
        color: white;
        flex-shrink: 0;
    }

    .staffhub-logo {
        padding: 18px 16px;
        border-bottom: 1px solid #2a3448;
    }

    .logo-box {
        width: 30px;
        height: 30px;
        background-color: #3d73e8;
        border-radius: 6px;
        margin-bottom: 8px;
    }

    .logo-title {
        font-size: 12px;
        font-weight: bold;
    }

    .logo-subtitle {
        font-size: 9px;
        color: #8e99ad;
    }

    .sidebar-section {
        padding: 20px 10px 5px;
        color: #717d92;
        font-size: 9px;
        font-weight: bold;
        letter-spacing: .8px;
    }

    .sidebar-link {
        display: block;
        color: #c4ccda;
        text-decoration: none;
        padding: 8px 16px;
        font-size: 12px;
        border-radius: 5px;
        margin: 2px 8px;
    }

    .sidebar-link:hover {
        background-color: #26334b;
        color: white;
    }

    .sidebar-link.active {
        background-color: #3973e8;
        color: white;
    }

    .employee-count {
        float: right;
        background-color: #6190f1;
        padding: 2px 7px;
        border-radius: 10px;
        font-size: 9px;
    }

    .sidebar-bottom {
        position: absolute;
        bottom: 0;
        width: 190px;
        padding: 15px;
        border-top: 1px solid #2a3448;
        box-sizing: border-box;
    }

    .admin-circle {
        display: inline-flex;
        width: 26px;
        height: 26px;
        background-color: #3d73e8;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        font-size: 11px;
    }

    .admin-info {
        display: inline-block;
        margin-left: 7px;
        vertical-align: middle;
    }

    .admin-name {
        font-size: 10px;
        font-weight: bold;
    }

    .admin-role {
        font-size: 8px;
        color: #8e99ad;
    }

    /* Main */
    .staffhub-main {
        flex: 1;
        min-width: 0;
    }

    .topbar {
        height: 62px;
        background-color: white;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 22px;
        box-sizing: border-box;
    }

    .page-title {
        font-size: 14px;
        font-weight: bold;
        margin: 0;
    }

    .breadcrumb {
        font-size: 10px;
        color: #8b94a5;
        margin-top: 2px;
    }

    .top-search {
        width: 175px;
        height: 28px;
        border: 1px solid #e1e5eb;
        border-radius: 7px;
        background-color: #f5f6f8;
        padding: 0 12px;
        font-size: 10px;
        outline: none;
    }

    .top-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .notification-btn,
    .profile-btn {
        width: 30px;
        height: 30px;
        border: 1px solid #e3e6eb;
        background-color: white;
        border-radius: 7px;
    }

    .notification-btn {
        position: relative;
    }

    .notification-dot {
        position: absolute;
        width: 5px;
        height: 5px;
        background-color: #e74c3c;
        border-radius: 50%;
        top: 7px;
        right: 7px;
    }

    .content {
        padding: 22px;
    }

    .content-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .content-title {
        font-size: 13px;
        font-weight: bold;
        margin: 0;
    }

    .content-subtitle {
        font-size: 10px;
        color: #8a94a5;
        margin-top: 3px;
    }

    .add-btn {
        background-color: #3d73e8;
        color: white;
        border: none;
        border-radius: 7px;
        padding: 7px 16px;
        font-size: 10px;
        font-weight: bold;
        text-decoration: none;
    }

    .add-btn:hover {
        background-color: #2f63d2;
        color: white;
    }

    /* Filters */
    .filter-card {
        background-color: white;
        border: 1px solid #e1e5eb;
        border-radius: 9px;
        padding: 11px 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
        box-shadow: 0 2px 7px rgba(0,0,0,.04);
    }

    .filter-label {
        font-size: 10px;
        color: #687385;
    }

    .filter-select,
    .filter-search {
        height: 27px;
        border: 1px solid #e1e5eb;
        border-radius: 6px;
        background-color: #f7f8fa;
        padding: 0 9px;
        font-size: 10px;
        color: #374151;
    }

    .filter-select {
        width: 112px;
    }

    .filter-search {
        width: 145px;
    }

    .filter-divider {
        height: 22px;
        width: 1px;
        background-color: #e5e7eb;
        margin: 0 2px;
    }

    .showing-count {
        margin-left: auto;
        font-size: 10px;
        color: #687385;
    }

    /* Table */
    .table-card {
        background-color: white;
        border: 1px solid #e1e5eb;
        border-radius: 9px;
        overflow: hidden;
        box-shadow: 0 2px 7px rgba(0,0,0,.04);
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .employee-table th {
        background-color: #f8f9fb;
        color: #657083;
        font-size: 9px;
        text-align: left;
        padding: 10px 15px;
        border-bottom: 1px solid #e4e7ec;
        letter-spacing: .3px;
    }

    .employee-table td {
        padding: 10px 15px;
        border-bottom: 1px solid #edf0f3;
        font-size: 10px;
        vertical-align: middle;
    }

    .employee-table tbody tr:hover {
        background-color: #fafbfc;
    }

    .employee-table th:nth-child(1) {
        width: 23%;
    }

    .employee-table th:nth-child(2) {
        width: 16%;
    }

    .employee-table th:nth-child(3) {
        width: 12%;
    }

    .employee-table th:nth-child(4) {
        width: 17%;
    }

    .employee-table th:nth-child(5) {
        width: 12%;
    }

    .employee-table th:nth-child(6) {
        width: 10%;
    }

    .employee-table th:nth-child(7) {
        width: 10%;
    }

    .employee-info {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .employee-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: #e8eefc;
        color: #3973e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .employee-name {
        font-size: 11px;
        color: #172033;
        font-weight: 500;
    }

    .employee-email {
        font-size: 9px;
        color: #7b8494;
        margin-top: 2px;
    }

    .phone {
        color: #687385;
    }

    .department-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 10px;
        background-color: #eef3ff;
        color: #4e6fae;
        font-size: 8px;
    }

    .job-title {
        color: #172033;
    }

    .hire-date {
        color: #687385;
    }

    .salary {
        color: #111827;
        font-weight: bold;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
    }

    .action-btn {
        width: 27px;
        height: 27px;
        border: 1px solid #e2e6eb;
        border-radius: 6px;
        background-color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 11px;
    }

    .action-btn:hover {
        background-color: #f3f5f8;
    }

    .view-btn {
        color: #3973e8;
    }

    .edit-btn {
        color: #f39c12;
    }

    .delete-btn {
        color: #e74c3c;
    }

    /* Footer */
    .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 15px;
    }

    .footer-text {
        color: #687385;
        font-size: 10px;
    }

    .pagination {
        display: flex;
        gap: 4px;
    }

    .page-btn {
        width: 27px;
        height: 27px;
        border: 1px solid #e1e5eb;
        background-color: white;
        border-radius: 5px;
        font-size: 10px;
        color: #596273;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
    }

    .page-btn.active {
        background-color: #3973e8;
        border-color: #3973e8;
        color: white;
    }
</style>


<div class="staffhub-wrapper">

    <!-- Sidebar -->
    <aside class="staffhub-sidebar">

        <div class="staffhub-logo">
            <div class="logo-box"></div>
            <div class="logo-title">StaffHub</div>
            <div class="logo-subtitle">Employee Management</div>
        </div>

        <div class="sidebar-section">
            OVERVIEW
        </div>

        <a href="#" class="sidebar-link">
            Dashboard
        </a>

        <div class="sidebar-section">
            MANAGEMENT
        </div>

        <a href="/Employee/Index" class="sidebar-link active">
            Employees
            <span class="employee-count">@Model.Count()</span>
        </a>

        <a href="#" class="sidebar-link">
            Departments
        </a>

        <a href="#" class="sidebar-link">
            Job Titles
        </a>

        <div class="sidebar-section">
            ACTIONS
        </div>

        <a asp-controller="Employee"
           asp-action="Create"
           class="sidebar-link">
            Add Employee
        </a>

        <div class="sidebar-bottom">

            <span class="admin-circle">A</span>

            <span class="admin-info">
                <span class="admin-name">Admin</span><br />
                <span class="admin-role">HR Manager</span>
            </span>

        </div>

    </aside>


    <!-- Main Content -->
    <main class="staffhub-main">

        <!-- Top Bar -->
        <header class="topbar">

            <div>
                <div class="page-title">
                    Employees
                </div>

                <div class="breadcrumb">
                    StaffHub / Employees / All
                </div>
            </div>


            <div class="top-actions">

                <input type="text"
                       class="top-search"
                       placeholder="Search employees..." />

                <button class="notification-btn">
                    <span class="notification-dot"></span>
                </button>

                <button class="profile-btn"></button>

            </div>

        </header>


        <!-- Page Content -->
        <section class="content">

            <!-- Header -->
            <div class="content-header">

                <div>
                    <h2 class="content-title">
                        All Employees
                    </h2>

                    <div class="content-subtitle">
                        Manage and browse your team
                    </div>
                </div>

                <a asp-controller="Employee"
                   asp-action="Create"
                   class="add-btn">
                    Add Employee
                </a>

            </div>


            <!-- Filters -->
            <div class="filter-card">

                <span class="filter-label">
                    Department
                </span>

                <select class="filter-select">
                    <option>All Departments</option>

                    @foreach (var department in Model
                                        .Where(e => e.Department != null)
                                        .Select(e => e.Department.Name)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option>@department</option>
                    }
                </select>


                <div class="filter-divider"></div>


                <span class="filter-label">
                    Job Title
                </span>

                <select class="filter-select">
                    <option>All Titles</option>

                    @foreach (var jobTitle in Model
                                        .Where(e => e.JobTitle != null)
                                        .Select(e => e.JobTitle.Title)
                                        .Distinct()
                                        .OrderBy(x => x))
                    {
                        <option>@jobTitle</option>
                    }
                </select>


                <div class="filter-divider"></div>


                <input type="text"
                       class="filter-search"
                       placeholder="Search..." />


                <span class="showing-count">
                    Showing @Model.Count() employees
                </span>

            </div>


            <!-- Employees Table -->
            <div class="table-card">

                <table class="employee-table">

                    <thead>
                        <tr>
                            <th>EMPLOYEE</th>
                            <th>PHONE</th>
                            <th>DEPARTMENT</th>
                            <th>JOB TITLE</th>
                            <th>HIRE DATE</th>
                            <th>SALARY</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>


                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var employee in Model)
                            {
                                var initials = "";

                                if (!string.IsNullOrWhiteSpace(employee.FullName))
                                {
                                    var parts = employee.FullName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                    if (parts.Length >= 2)
                                    {
                                        initials =
                                        parts[0].Substring(0, 1).ToUpper() +
                                        parts[1].Substring(0, 1).ToUpper();
                                    }
                                    else
                                    {
                                        initials =
                                        parts[0].Substring(0, 1).ToUpper();
                                    }
                                }

                                <tr>

                                    <td>
                                        <div class="employee-info">

                                            <div class="employee-avatar">
                                                @initials
                                            </div>

                                            <div>
                                                <div class="employee-name">
                                                    @employee.FullName
                                                </div>

                                                <div class="employee-email">
                                                    @employee.Email
                                                </div>
                                            </div>

                                        </div>
                                    </td>


                                    <td class="phone">
                                        @employee.PhoneNumber
                                    </td>


                                    <td>
                                        <span class="department-badge">
                                            @(employee.Department?.Name ?? "-")
                                        </span>
                                    </td>


                                    <td class="job-title">
                                        @(employee.JobTitle?.Title ?? "-")
                                    </td>


                                    <td class="hire-date">
                                        @employee.HireDate.ToString("MMM dd, yyyy")
                                    </td>


                                    <td class="salary">
                                        $@employee.Salary.ToString("N0")
                                    </td>


                                    <td>

                                        <div class="action-buttons">

                                            <a asp-action="Details"
                                               asp-route-id="@employee.Id"
                                               class="action-btn view-btn"
                                               title="Details">
                                                👁
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@employee.Id"
                                               class="action-btn edit-btn"
                                               title="Edit">
                                                ✎
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@employee.Id"
                                               class="action-btn delete-btn"
                                               title="Delete">
                                                🗑
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    style="text-align:center; padding:35px; color:#7b8494;">
                                    No employees found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>


                <!-- Table Footer -->
                <div class="table-footer">

                    <div class="footer-text">
                        Showing 1-@Model.Count() of @Model.Count() employees
                    </div>


                    <div class="pagination">

                        <a href="#" class="page-btn">
                            ‹
                        </a>

                        <a href="#" class="page-btn active">
                            1
                        </a>

                        <a href="#" class="page-btn">
                            2
                        </a>

                        <a href="#" class="page-btn">
                            3
                        </a>

                        <span class="page-btn">
                            ...
                        </span>

                        <a href="#" class="page-btn">
                            5
                        </a>

                        <a href="#" class="page-btn">
                            ›
                        </a>

                    </div>

                </div>

            </div>

        </section>

    </main>

</div>