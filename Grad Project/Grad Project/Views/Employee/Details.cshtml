@model Grad_Project.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<style>
    .page-container {
        padding: 30px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
        }

    .details-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        max-width: 900px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    /* Updated Larger, Modern Header Profile Section */
    .employee-header {
        display: flex;
        align-items: center;
        gap: 25px;
        padding-bottom: 30px;
        margin-bottom: 30px;
        border-bottom: 1px solid #eaeaea;
    }

    .employee-avatar {
        width: 130px;
        height: 160px; /* Changed to a portrait (vertical) shape to fit more of the photo */
        border-radius: 16px; /* Modern rounded corners instead of a strict circle */
        background: #2563eb;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        font-weight: 700;
        overflow: hidden;
        flex-shrink: 0;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        border: 4px solid #ffffff;
    }

        .employee-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: top center; /* MAGIC FIX: Anchors the image to the top so the head is never cut off */
        }

    .employee-header h3 {
        margin: 0;
        font-weight: 800;
        font-size: 26px;
        color: #111827;
        letter-spacing: -0.5px;
    }

    .employee-header p {
        margin: 6px 0 0;
        color: #4b5563;
        font-size: 16px;
        font-weight: 500;
    }

    /* Details Grid Styles */
    .detail-item {
        margin-bottom: 22px;
    }

    .detail-label {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .detail-value {
        font-size: 16px;
        font-weight: 500;
        color: #111827;
    }

    /* Action Buttons */
    .btn-edit {
        background: #2563eb;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-edit:hover {
            background: #1d4ed8;
            color: white;
            text-decoration: none;
        }

    .btn-back {
        padding: 10px 22px;
        border-radius: 8px;
        margin-left: 8px;
    }
</style>

<div class="page-container">

    <div class="page-header">

        <div>
            <h2>Employee Details</h2>

            <p class="text-muted mb-0">
                View employee information
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Employees
        </a>

    </div>

    <div class="details-card">

        <div class="employee-header">

            <div class="employee-avatar">
                @if (string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                {
                    <!-- Fallback to Initials if no image exists -->
                    @if (!string.IsNullOrWhiteSpace(Model.FullName))
                    {
                        @Model.FullName.Substring(0, 1).ToUpper()
                    }
                }
                else
                {
                    <!-- Render the Photo using the Picture Action -->
                    <img src="@Url.Action("Picture", "Employee", new { id = Model.Id })" alt="@Model.FullName" />
                }
            </div>

            <div>
                <h3>@Model.FullName</h3>

                <p>
                    @(Model.JobTitle?.Title ?? "No Job Title Assigned")
                </p>
            </div>

        </div>

        <div class="row">

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Full Name</span>
                    <div class="detail-value">@Model.FullName</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Email</span>
                    <div class="detail-value">@Model.Email</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Phone Number</span>
                    <div class="detail-value">@Model.PhoneNumber</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Department</span>
                    <div class="detail-value">@(Model.Department?.Name ?? "-")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Job Title</span>
                    <div class="detail-value">@(Model.JobTitle?.Title ?? "-")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Hire Date</span>
                    <div class="detail-value">@Model.HireDate.ToString("MMM dd, yyyy")</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="detail-item">
                    <span class="detail-label">Salary</span>
                    <div class="detail-value">$@Model.Salary.ToString("N0")</div>
                </div>
            </div>

        </div>

        <hr />

        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn-edit">
                Edit Employee
            </a>

            <a asp-action="Index"
               class="btn btn-secondary btn-back">
                Back
            </a>

        </div>

    </div>
</div>