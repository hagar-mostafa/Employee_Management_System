@model Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<style>
    .page-container {
        padding: 30px;
        background: #f5f7fb;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
        }

    .delete-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        max-width: 900px;
        box-shadow: 0 2px 10px rgba(0,0,0,.05);
    }

    .warning-box {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
    }

    .employee-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 25px;
        margin-bottom: 25px;
        border-bottom: 1px solid #eee;
    }

    .employee-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: #dc2626;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 700;
    }

    .employee-header h3 {
        margin: 0;
        font-weight: 700;
    }

    .employee-header p {
        margin: 4px 0 0;
        color: #6b7280;
    }

    .detail-item {
        margin-bottom: 20px;
    }

    .detail-label {
        display: block;
        font-size: 13px;
        color: #6b7280;
        margin-bottom: 5px;
        font-weight: 600;
    }

    .detail-value {
        font-size: 16px;
        font-weight: 500;
        color: #111827;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        padding: 10px 22px;
        border-radius: 8px;
        font-weight: 600;
    }

        .btn-delete:hover {
            background: #b91c1c;
            color: white;
        }

    .btn-cancel {
        padding: 10px 22px;
        border-radius: 8px;
        margin-left: 8px;
    }
</style>

<div class="page-container">

    <div class="page-header">

        <div>
            <h2>Delete Employee</h2>

            <p class="text-muted mb-0">
                Remove employee from the system
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back to Employees
        </a>

    </div>

    <div class="delete-card">

        <div class="warning-box">
            <strong>Warning:</strong>
            Are you sure you want to delete this employee?
            This action cannot be undone.
        </div>

        <div class="employee-header">

            <div class="employee-avatar">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>

            <div>
                <h3>@Model.FullName</h3>

                <p>
                    @Model.JobTitle?.Title
                </p>
            </div>

        </div>

        <div class="row">

            <div class="col-md-6">

                <div class="detail-item">
                    <span class="detail-label">
                        Full Name
                    </span>

                    <div class="detail-value">
                        @Model.FullName
                    </div>
                </div>

            </div>

            <div class="col-md-6">

                <div class="detail-item">
                    <span class="detail-label">
                        Email
                    </span>

                    <div class="detail-value">
                        @Model.Email
                    </div>
                </div>

            </div>

            <div class="col-md-6">

                <div class="detail-item">
                    <span class="detail-label">
                        Phone Number
                    </span>

                    <div class="detail-value">
                        @Model.PhoneNumber
                    </div>
                </div>

            </div>

            <div class="col-md-6">

                <div class="detail-item">
                    <span class="detail-label">
                        Department
                    </span>

                    <div class="detail-value">
                        @Model.Department?.Name
                    </div>
                </div>

            </div>

            <div class="col-md-6">

                <div class="detail-item">
                    <span class="detail-label">
                        Job Title
                    </span>

                    <div class="detail-value">
                        @Model.JobTitle?.Title
                    </div>
                </div>

            </div>

            <div class="col-md-6">

                <div class="detail-item">
                    <span class="detail-label">
                        Hire Date
                    </span>

                    <div class="detail-value">
                        @Model.HireDate.ToShortDateString()
                    </div>
                </div>

            </div>

        </div>

        <hr />

        <div class="mt-4">

            <form asp-action="Delete"
                  method="post"
                  style="display:inline;">

                <input type="hidden"
                       asp-for="Id" />

                <button type="submit"
                        class="btn-delete">
                    Delete Employee
                </button>

            </form>

            <a asp-action="Index"
               class="btn btn-secondary btn-cancel">
                Cancel
            </a>

        </div>

    </div>

</div>