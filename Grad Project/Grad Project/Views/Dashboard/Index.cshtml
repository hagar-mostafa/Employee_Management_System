@model Grad_Project.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    body {
        margin: 0;
        background-color: #f4f6f9;
        font-family: Arial, sans-serif;
        color: #1f2937;
    }

    .staffhub-wrapper {
        display: flex;
        min-height: 100vh;
    }

    .staffhub-main {
        flex: 1;
        min-width: 0;
    }

    /* Topbar */
    .topbar {
        height: 62px;
        background-color: white;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 22px;
        box-sizing: border-box;
    }

    .page-title {
        font-size: 15px;
        font-weight: bold;
        margin: 0;
    }

    .breadcrumb {
        font-size: 11px;
        color: #8b94a5;
        margin-top: 2px;
    }

    .top-search {
        width: 200px;
        height: 32px;
        border: 1px solid #e1e5eb;
        border-radius: 7px;
        background-color: #f5f6f8;
        padding: 0 12px;
        font-size: 12px;
        outline: none;
    }

    .top-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* Dashboard Content */
    .content {
        padding: 25px;
    }

    /* Modern Stat Cards */
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
        margin-bottom: 35px;
    }

    .stat-card {
        background-color: white;
        border: 1px solid #f0f2f5;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
        position: relative;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .stat-icon svg {
            width: 24px;
            height: 24px;
        }

    .bg-blue {
        background-color: #edf2fe;
        color: #3b82f6;
    }

    .bg-green {
        background-color: #eafaf1;
        color: #10b981;
    }

    .bg-yellow {
        background-color: #fff8e6;
        color: #f59e0b;
    }

    .bg-red {
        background-color: #ffefef;
        color: #ef4444;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: #111827;
        margin-bottom: 4px;
        letter-spacing: -0.5px;
    }

    .stat-label {
        font-size: 13px;
        color: #6b7280;
        font-weight: 500;
    }

    .stat-trend {
        position: absolute;
        top: 24px;
        right: 24px;
        font-size: 13px;
        font-weight: 700;
        color: #00b894;
        display: flex;
        align-items: center;
        gap: 2px;
    }

    /* Recent Employees Section Header */
    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .section-title h3 {
        margin: 0;
        font-size: 15px;
        font-weight: bold;
        color: #111827;
    }

    .section-title p {
        margin: 4px 0 0;
        font-size: 12px;
        color: #6b7280;
    }

    .btn-view-all {
        background-color: #3d73e8;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 6px 16px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
    }

        .btn-view-all:hover {
            background-color: #2f63d2;
            color: white;
        }

    /* Index Table Styles */
    .table-card {
        background-color: white;
        border: 1px solid #e1e5eb;
        border-radius: 9px;
        overflow: hidden;
        box-shadow: 0 2px 7px rgba(0,0,0,.04);
    }

    .employee-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

        .employee-table th {
            background-color: #f8f9fb;
            color: #657083;
            font-size: 9px;
            text-align: left;
            padding: 10px 15px;
            border-bottom: 1px solid #e4e7ec;
            letter-spacing: .3px;
        }

        .employee-table td {
            padding: 10px 15px;
            border-bottom: 1px solid #edf0f3;
            font-size: 10px;
            vertical-align: middle;
        }

        .employee-table tbody tr:hover {
            background-color: #fafbfc;
        }

        .employee-table th:nth-child(1) {
            width: 23%;
        }

        .employee-table th:nth-child(2) {
            width: 16%;
        }

        .employee-table th:nth-child(3) {
            width: 12%;
        }

        .employee-table th:nth-child(4) {
            width: 17%;
        }

        .employee-table th:nth-child(5) {
            width: 12%;
        }

        .employee-table th:nth-child(6) {
            width: 10%;
        }

        .employee-table th:nth-child(7) {
            width: 10%;
        }

    .employee-info {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .employee-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background-color: #e8eefc;
        color: #3973e8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .employee-name {
        font-size: 11px;
        color: #172033;
        font-weight: 500;
    }

    .employee-email {
        font-size: 9px;
        color: #7b8494;
        margin-top: 2px;
    }

    .phone {
        color: #687385;
    }

    .department-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 10px;
        background-color: #eef3ff;
        color: #4e6fae;
        font-size: 8px;
    }

    .job-title {
        color: #172033;
    }

    .hire-date {
        color: #687385;
    }

    .salary {
        color: #111827;
        font-weight: bold;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
    }

    .action-btn {
        width: 27px;
        height: 27px;
        border: 1px solid #e2e6eb;
        border-radius: 6px;
        background-color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 11px;
    }

        .action-btn:hover {
            background-color: #f3f5f8;
        }

    .view-btn {
        color: #3973e8;
    }

    .edit-btn {
        color: #f39c12;
    }

    .delete-btn {
        color: #e74c3c;
    }
</style>

<div class="staffhub-wrapper">

    <main class="staffhub-main">

        <!-- Top Bar -->
        <header class="topbar">
            <div>
                <div class="page-title">Dashboard</div>
                <div class="breadcrumb">StaffHub / Dashboard</div>
            </div>
            <div class="top-actions">
                <input type="text" class="top-search" placeholder="Search employees..." />
            </div>
        </header>

        <section class="content">

            <!-- 4 Grid Stat Cards with Icons -->
            <div class="dashboard-grid">

                <!-- Total Employees Card -->
                <div class="stat-card">
                    <div class="stat-icon bg-blue">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                        </svg>
                    </div>
                    <div class="stat-trend">↑ 3.2%</div>
                    <div class="stat-value">@Model.TotalEmployees</div>
                    <div class="stat-label">Total Employees</div>
                </div>

                <!-- Departments Card -->
                <div class="stat-card">
                    <div class="stat-icon bg-green">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                    </div>
                    <div class="stat-trend">↑ 1</div>
                    <div class="stat-value">@Model.TotalDepartments</div>
                    <div class="stat-label">Departments</div>
                </div>

                <!-- Job Titles Card -->
                <div class="stat-card">
                    <div class="stat-icon bg-yellow">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.222-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <div class="stat-trend">↑ 2</div>
                    <div class="stat-value">@Model.TotalJobTitles</div>
                    <div class="stat-label">Job Titles</div>
                </div>

                <!-- Hired This Month Card -->
                <div class="stat-card">
                    <div class="stat-icon bg-red">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                        </svg>
                    </div>
                    <div class="stat-trend">↑ 5</div>
                    <div class="stat-value">@Model.HiredThisMonth</div>
                    <div class="stat-label">Hired This Month</div>
                </div>

            </div>

            <!-- Recent Employees Section Header -->
            <div class="section-header">
                <div class="section-title">
                    <h3>Recent Employees</h3>
                    <p>Last 5 employees added to the system</p>
                </div>
                <a asp-controller="Employee" asp-action="Index" class="btn-view-all">View All Employees</a>
            </div>

            <!-- Table -->
            <div class="table-card">
                <table class="employee-table">

                    <thead>
                        <tr>
                            <th>EMPLOYEE</th>
                            <th>PHONE</th>
                            <th>DEPARTMENT</th>
                            <th>JOB TITLE</th>
                            <th>HIRE DATE</th>
                            <th>SALARY</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.RecentEmployees != null && Model.RecentEmployees.Any())
                        {
                            @foreach (var employee in Model.RecentEmployees)
                            {
                                var initials = "";

                                if (!string.IsNullOrWhiteSpace(employee.FullName))
                                {
                                    var parts = employee.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                    if (parts.Length >= 2)
                                    {
                                        initials = parts[0].Substring(0, 1).ToUpper() + parts[1].Substring(0, 1).ToUpper();
                                    }
                                    else
                                    {
                                        initials = parts[0].Substring(0, 1).ToUpper();
                                    }
                                }

                                <tr>
                                    <td>
                                        <div class="employee-info">
                                            @if (string.IsNullOrWhiteSpace(employee.ProfileImagePath))
                                            {
                                                <div class="employee-avatar">
                                                    @initials
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="employee-avatar" style="background-color: transparent;">
                                                    <img src="@Url.Action("Picture", "Employee", new { id = employee.Id })"
                                                         alt="@employee.FullName"
                                                         style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover; object-position: top center;" />
                                                </div>
                                            }

                                            <div>
                                                <div class="employee-name">
                                                    @employee.FullName
                                                </div>
                                                <div class="employee-email">
                                                    @employee.Email
                                                </div>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="phone">
                                        @employee.PhoneNumber
                                    </td>

                                    <td>
                                        <span class="department-badge">
                                            @(employee.Department?.Name ?? "-")
                                        </span>
                                    </td>

                                    <td class="job-title">
                                        @(employee.JobTitle?.Title ?? "-")
                                    </td>

                                    <td class="hire-date">
                                        @employee.HireDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td class="salary">
                                        $@employee.Salary.ToString("N0")
                                    </td>

                                    <td>
                                        <div class="action-buttons">
                                            <a asp-controller="Employee" asp-action="Details" asp-route-id="@employee.Id" class="action-btn view-btn" title="Details">👁</a>
                                            <a asp-controller="Employee" asp-action="Edit" asp-route-id="@employee.Id" class="action-btn edit-btn" title="Edit">✎</a>
                                            <a asp-controller="Employee" asp-action="Delete" asp-route-id="@employee.Id" class="action-btn delete-btn" title="Delete">🗑</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" style="text-align:center; padding:35px; color:#7b8494;">
                                    No recent employees found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </section>
    </main>
</div>