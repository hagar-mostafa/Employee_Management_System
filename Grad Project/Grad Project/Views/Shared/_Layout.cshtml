<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — StaffHub</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ══════════════════════════════════════
         SIDEBAR
    ══════════════════════════════════════ -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon"><i class="fas fa-users"></i></div>
            <h1>StaffHub</h1>
            <p>Employee Management</p>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-label">Overview</div>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
               asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-chart-pie"></i> Dashboard
            </a>

            <div class="nav-label">Management</div>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
               asp-controller="Employee" asp-action="Index">
                <i class="fas fa-id-badge"></i> Employees
            </a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Department" ? "active" : "")"
               asp-controller="Department" asp-action="Index">
                <i class="fas fa-building"></i> Departments
            </a>
            <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "JobTitle" ? "active" : "")"
               asp-controller="JobTitle" asp-action="Index">
                <i class="fas fa-briefcase"></i> Job Titles
            </a>

            <div class="nav-label">Actions</div>
            <a class="nav-item" asp-controller="Employee" asp-action="Create">
                <i class="fas fa-user-plus"></i> Add Employee
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="user-avatar">A</div>
                <div class="user-info">
                    <div class="user-name">Admin</div>
                    <div class="user-role">HR Manager</div>
                </div>
                <i class="fas fa-ellipsis-h" style="color:rgba(255,255,255,.3);margin-left:auto;font-size:12px;"></i>
            </div>
        </div>
    </aside>

    <!-- ══════════════════════════════════════
         MAIN AREA
    ══════════════════════════════════════ -->
    <div class="main">

        <!-- TOPBAR -->
        <header class="topbar">
            <div>
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-breadcrumb">
                    StaffHub <span>/ @ViewData["Title"]</span>
                </div>
            </div>
            <div class="topbar-actions">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" placeholder="Search employees…" />
                </div>
                <button class="icon-btn">
                    <i class="fas fa-bell"></i>
                    <span class="dot"></span>
                </button>
                <button class="icon-btn">
                    <i class="fas fa-cog"></i>
                </button>
            </div>
        </header>

        <!-- CONTENT — كل View بتتحط هنا تلقائياً -->
        <div class="content">
            @RenderBody()
        </div>

    </div>

    @RenderSection("Scripts", required: false)

</body>
</html>
