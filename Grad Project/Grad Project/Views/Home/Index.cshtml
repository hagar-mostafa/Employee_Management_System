@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
}

<!-- STAT CARDS -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon blue"><i class="fas fa-users"></i></div>
            <span class="stat-trend up">Total</span>
        </div>
        <div class="stat-value">@ViewBag.EmployeeCount</div>
        <div class="stat-label">Total Employees</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon green"><i class="fas fa-building"></i></div>
            <span class="stat-trend up">Total</span>
        </div>
        <div class="stat-value">@ViewBag.DepartmentCount</div>
        <div class="stat-label">Departments</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon yellow"><i class="fas fa-briefcase"></i></div>
            <span class="stat-trend up">Total</span>
        </div>
        <div class="stat-value">@ViewBag.JobTitleCount</div>
        <div class="stat-label">Job Titles</div>
    </div>

    <div class="stat-card">
        <div class="stat-header">
            <div class="stat-icon red"><i class="fas fa-user-plus"></i></div>
            <span class="stat-trend up">Latest</span>
        </div>
        <div class="stat-value">
            @(((System.Collections.IList)ViewBag.RecentEmployees).Count)
        </div>
        <div class="stat-label">Recent Hires</div>
    </div>
</div>

<!-- RECENT EMPLOYEES TABLE -->
<div class="section-header">
    <div>
        <h2>Recent Employees</h2>
        <p>Last 5 employees added to the system</p>
    </div>
    <a asp-controller="Employee" asp-action="Index" class="btn btn-primary btn-sm">
        <i class="fas fa-arrow-right"></i> View All
    </a>
</div>

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Employee</th>
                <th>Department</th>
                <th>Job Title</th>
                <th>Hire Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (ViewBag.RecentEmployees != null)
            {
                foreach (var emp in ViewBag.RecentEmployees)
                {
                    var parts = emp.FullName.Split(' ');
                    string initials = (parts.Length >= 2)
                        ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
                        : parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();

                    <tr>
                        <td>
                            <div class="emp-cell">
                                <div class="emp-avatar">@initials</div>
                                <div>
                                    <div class="emp-name">@emp.FullName</div>
                                    <div class="emp-email">@emp.Email</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-blue">@emp.Department?.Name</span>
                        </td>
                        <td>@emp.JobTitle?.Title</td>
                        <td style="color:var(--text-sub)">
                            @emp.HireDate.ToString("MMM dd, yyyy")
                        </td>
                        <td>
                            <div class="action-btns">
                                <a asp-controller="Employee"
                                   asp-action="Details"
                                   asp-route-id="@emp.Id"
                                   class="act-btn view" title="View">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-controller="Employee"
                                   asp-action="Edit"
                                   asp-route-id="@emp.Id"
                                   class="act-btn edit" title="Edit">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <a asp-controller="Employee"
                                   asp-action="Delete"
                                   asp-route-id="@emp.Id"
                                   class="act-btn delete" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">
                        <div class="empty-state">
                            <i class="fas fa-users"></i>
                            <h3>No Employees Yet</h3>
                            <p>Start by adding your first employee</p>
                            <a asp-controller="Employee"
                               asp-action="Create"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Add Employee
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
