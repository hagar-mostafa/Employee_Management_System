@model Grad_Project.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<div class="content">

    <div class="section-header">
        <div>
            <h2>Delete Department</h2>
            <p>Remove a department from the organization.</p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Departments
        </a>
    </div>

    <div class="form-card">

        <div class="form-card-title">
            <span>Delete Confirmation</span>
        </div>

        <div class="alert error">
            Are you sure you want to delete this department?
        </div>

        <div class="info-grid">

            <div class="info-item">
                <label>Department ID</label>
                <p>@Model.Id</p>
            </div>

            <div class="info-item">
                <label>Department Name</label>
                <p>@Model.Name</p>
            </div>

            <div class="info-item">
                <label>Employees</label>
                <p>@(Model.Employees?.Count ?? 0)</p>
            </div>

        </div>

        @if (Model.Employees != null && Model.Employees.Count > 0)
        {
            <div class="alert error" style="margin-top: 20px;">
                Cannot delete this department because it has
                @Model.Employees.Count employee(s).
                Move or delete the employees first.
            </div>
        }

        <form asp-action="Delete"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="form-actions">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

                @if (Model.Employees == null || Model.Employees.Count == 0)
                {
                    <button type="submit"
                            class="btn btn-danger">
                        Delete Department
                    </button>
                }

            </div>

        </form>

    </div>

</div>